{
  "name": "vector-qsort",
  "version": "0.1.0",
  "description": "Vectorized quicksort for TypedArrays using Google Highway SIMD.",
  "type": "module",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    }
  },
  "scripts": {
    "install": "cmake-js compile",
    "build": "cmake-js compile",
    "test": "node --test test/*.test.js",
    "bench": "node bench/index.bench.mjs",
    "prepack": "mkdir -p include && cp ../core/vqsort.h ./include/ && cp ../LICENSE . && cp ../README.md .",
    "postpack": "rm -f LICENSE README.md"
  },
  "files": [
    "binding.cc",
    "index.js",
    "index.d.ts",
    "CMakeLists.txt",
    "include",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "node-addon-api": "^8.9.2"
  },
  "devDependencies": {
    "cmake-js": "^8.0.0",
    "mitata": "^1.0.34"
  },
  "author": "Hemanth HM <hemanth@h3manth.com> (https://h3manth.com)",
  "license": "MIT"
}
